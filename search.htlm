<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Résultats de recherche LAMxSEARCH." />
<meta name="robots" content="noindex" />
<link rel="icon" type="image/svg+xml" href="assets/favicon.svg" />
<link rel="manifest" href="manifest.json" />
<link rel="stylesheet" href="css/base.css" />
<link rel="stylesheet" href="css/components.css" />
<link rel="stylesheet" href="css/layout.css" />
<title>Résultats — LAMxSEARCH</title>
</head>
<body data-page="search">

<header class="site-header site-header--compact">
  <div class="container header-inner">
    <a href="index.html" class="brand" aria-label="Accueil">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="26" height="26">
          <defs><linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0a66ff"/><stop offset="1" stop-color="#00c2ff"/>
          </linearGradient></defs>
          <circle cx="14" cy="14" r="9" fill="none" stroke="url(#g2)" stroke-width="3"/>
          <line x1="21" y1="21" x2="28" y2="28" stroke="url(#g2)" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand-text"><b>LAM</b><i>x</i><span>SEARCH</span></span>
    </a>

    <form id="searchFormInline" class="search-inline" role="search">
      <div class="search-shell search-shell--inline">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </span>
        <input id="searchInputInline" name="q" type="text" placeholder="Rechercher…" aria-label="Recherche" />
        <button type="submit" class="search-btn search-btn--sm">OK</button>
      </div>
    </form>

    <div class="header-tools">
      <button id="themeToggle" class="icon-btn" aria-label="Thème">🌙</button>
      <button id="settingsBtn" class="icon-btn" aria-label="Paramètres">⚙️</button>
    </div>
  </div>

  <nav class="result-tabs container" role="tablist" aria-label="Type">
    <button class="tab is-active" data-tab="web" role="tab">🌐 Web</button>
    <button class="tab" data-tab="images" role="tab">🖼️ Images</button>
    <button class="tab" data-tab="videos" role="tab">🎬 Vidéos</button>
    <button class="tab" data-tab="news" role="tab">📰 Actualités</button>
    <button class="tab" data-tab="maps" role="tab">🗺️ Maps</button>
  </nav>
</header>

<main class="site-main results-page">
  <div class="container">
    <div id="resultsMeta" class="results-meta">
      <span id="resultsTime"></span>
    </div>

    <div id="loader" class="loader" hidden>
      <div class="spinner"></div><p>Recherche en cours…</p>
    </div>

    <div id="resultsList" class="results-list" aria-live="polite"></div>

    <div id="emptyState" class="empty-state" hidden>
      <div class="empty-ico">🔎</div>
      <h2>Aucun résultat</h2>
      <p>Essayez avec d'autres mots-clés ou vérifiez l'orthographe.</p>
    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© <span id="year"></span> <b>LAMxSEARCH</b></p>
    <nav class="footer-nav">
      <a href="about.html">À propos</a>
      <a href="privacy.html">Confidentialité</a>
      <a href="terms.html">Conditions</a>
    </nav>
  </div>
</footer>

<aside id="settingsPanel" class="settings-panel" aria-hidden="true">
  <div class="settings-inner">
    <header class="settings-head">
      <h2>Paramètres</h2>
      <button id="settingsClose" class="icon-btn" aria-label="Fermer">✕</button>
    </header>
    <div class="settings-body">
      <div class="setting">
        <label for="themeSelect">Thème</label>
        <select id="themeSelect">
          <option value="light">Clair</option><option value="dark">Sombre</option><option value="auto">Auto</option>
        </select>
      </div>
      <button id="clearHistory" class="btn btn-danger">Effacer l'historique</button>
    </div>
  </div>
  <div id="settingsOverlay" class="settings-overlay"></div>
</aside>

<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script type="module" src="js/app.js"></script>
</body>
</html>
